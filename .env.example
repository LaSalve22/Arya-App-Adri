# Copier ce fichier en ".env" (même dossier) puis remplir les valeurs.
# Le fichier .env est ignoré par Git : il ne doit JAMAIS être commité.

# Dossier commun MT4 (FILE_COMMON). Laisser vide pour la valeur par défaut :
# %APPDATA%\MetaQuotes\Terminal\Common\Files
RADAR_COMMON_DIR=

# Code PIN de l'appli (étape 4)
RADAR_PIN=

# Clés Web Push (étape 5)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=
